if(NOT DEFINED SOURCE_DIR OR NOT DEFINED WORK_DIR)
    message(FATAL_ERROR "SOURCE_DIR and WORK_DIR are required")
endif()
string(RANDOM LENGTH 12 suffix)
set(test_dir "${WORK_DIR}/config-install-${suffix}")
set(EVEREST_UI_INSTALL_CONFIG_DIR "/etc/everest-ui")
set(EVEREST_UI_INSTALL_FRONTEND_CONFIG "${EVEREST_UI_INSTALL_CONFIG_DIR}/frontend.conf")
set(EVEREST_UI_INSTALL_BACKEND_DEFAULTS "/usr/share/everest-ui/config/backend.conf")
set(EVEREST_UI_INSTALL_FRONTEND_DEFAULTS "/usr/share/everest-ui/config/frontend.conf")
set(EVEREST_UI_OVERLAY_TEMPLATE_DIR "${test_dir}/templates")
file(MAKE_DIRECTORY "${EVEREST_UI_OVERLAY_TEMPLATE_DIR}")
foreach(name IN ITEMS backend frontend)
    configure_file("${SOURCE_DIR}/backend/config/${name}.overlay.conf.in"
        "${EVEREST_UI_OVERLAY_TEMPLATE_DIR}/${name}.overlay.conf" @ONLY)
endforeach()
set(WEBSERVER_INSTALL_ROOT "/usr/share/everest-ui/public")
set(EVEREST_UI_INSTALL_AUTH_FILE "/var/lib/everest-ui/auth.json")
configure_file("${SOURCE_DIR}/backend/api/config/backend.conf" "${test_dir}/backend.conf" COPYONLY)
configure_file("${SOURCE_DIR}/backend/webserver/config/frontend.conf.in" "${test_dir}/frontend.conf" @ONLY)
foreach(name IN ITEMS backend frontend)
    file(READ "${test_dir}/${name}.conf" content)
    string(FIND "${content}" "# Local Overrides (documentation only)" footer_offset)
    if(footer_offset LESS 0)
        message(FATAL_ERROR "Missing local override guide in ${name} defaults")
    endif()
    string(SUBSTRING "${content}" ${footer_offset} -1 footer)
    if(NOT footer MATCHES "/etc/everest-ui/${name}.conf")
        message(FATAL_ERROR "Missing local override location in ${name} defaults guide")
    endif()
    string(REGEX REPLACE "#[^\n]*" "" uncommented "${footer}")
    string(STRIP "${uncommented}" uncommented)
    if(NOT uncommented STREQUAL "")
        message(FATAL_ERROR "Distribution defaults guide must contain only comments/whitespace")
    endif()
endforeach()
configure_file("${SOURCE_DIR}/backend/config/InstallConfigOverlays.cmake.in" "${test_dir}/install.cmake" @ONLY)

function(run_install)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env "DESTDIR=${test_dir}/stage"
        "${CMAKE_COMMAND}" -P "${test_dir}/install.cmake" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
        message(FATAL_ERROR "Overlay installation failed: ${status}")
    endif()
endfunction()

run_install()
foreach(name IN ITEMS backend frontend)
    set(target "${test_dir}/stage/etc/everest-ui/${name}.conf")
    file(READ "${target}" content)
    if(NOT content MATCHES "/usr/share/everest-ui/config/${name}.conf")
        message(FATAL_ERROR "Missing defaults location in ${name} overlay")
    endif()
    string(REGEX REPLACE "#[^\n]*" "" uncommented "${content}")
    string(STRIP "${uncommented}" uncommented)
    if(NOT uncommented STREQUAL "")
        message(FATAL_ERROR "Fresh overlay must contain only comments/whitespace")
    endif()
endforeach()

set(backend "${test_dir}/stage/etc/everest-ui/backend.conf")
set(frontend "${test_dir}/stage/etc/everest-ui/frontend.conf")
file(WRITE "${backend}" "# existing complete legacy configuration\nbackend_port=9123\nfuture.key=preserve\n")
file(WRITE "${frontend}" "# local override\nport=8080\n")
file(SHA256 "${backend}" backend_before)
file(SHA256 "${frontend}" frontend_before)
run_install()
file(SHA256 "${backend}" backend_after)
file(SHA256 "${frontend}" frontend_after)
if(NOT backend_before STREQUAL backend_after OR NOT frontend_before STREQUAL frontend_after)
    message(FATAL_ERROR "Installation modified existing local configuration")
endif()

if(UNIX)
    file(REMOVE "${frontend}")
    file(CREATE_LINK "${test_dir}/missing-target" "${frontend}" SYMBOLIC)
    run_install()
    if(NOT IS_SYMLINK "${frontend}")
        message(FATAL_ERROR "Installation replaced an existing dangling symlink")
    endif()
endif()
file(REMOVE_RECURSE "${test_dir}")
message(STATUS "Overlay creation and preservation checks passed")
