{
  "modules": {
    "safety": {
      "title": "Safety Controller",
      "actions": {
        "read_settings": {
          "group": "safety",
          "action": "read_settings",
          "parameters_mode": "empty"
        },
        "write_settings": {
          "group": "safety",
          "action": "write_settings",
          "parameters_mode": "from_catalog"
        }
      },
      "settings_matrix": [
        {
          "id": "pt1000",
          "display_name": "PT1000 Resistors",
          "instances": [
            { "id": "0", "display_name": "PT1000 1" },
            { "id": "1", "display_name": "PT1000 2" },
            { "id": "2", "display_name": "PT1000 3" },
            { "id": "3", "display_name": "PT1000 4" }
          ],
          "fields": [
            {
              "id": "overtemperature-protection",
              "display_name": "Overtemperature Protection",
              "description": "Enable or disable PT1000 channel protection.",
              "value_type": "boolean",
              "backend_path": "pt1000_{instance}.overtemperature-protection"
            },
            {
              "id": "abort-temperature",
              "display_name": "Abort Temperature",
              "description": "Shutdown threshold for this PT1000 channel.",
              "value_type": "float",
              "default_value": 0,
              "unit": "degC",
              "backend_path": "pt1000_{instance}.abort-temperature"
            },
            {
              "id": "resistance-offset",
              "display_name": "Resistance Offset",
              "description": "Calibration offset/resistance for this PT1000 channel.",
              "value_type": "float",
              "default_value": 0,
              "unit": "ohm",
              "backend_path": "pt1000_{instance}.resistance-offset"
            }
          ]
        },
        {
          "id": "contactors",
          "display_name": "Contactors",
          "instances": [
            { "id": "0", "display_name": "Contactor 1" },
            { "id": "1", "display_name": "Contactor 2" }
          ],
          "fields": [
            {
              "id": "type",
              "display_name": "Type",
              "description": "fill in later",
              "value_type": "enum",
              "enum_values": [
                "disabled",
                "without-feedback",
                "with-feedback-normally-closed",
                "with-feedback-normally-open"
              ],
              "backend_path": "contactors_{instance}.type"
            },
            {
              "id": "close-time",
              "display_name": "Close Time",
              "description": "fill in later",
              "value_type": "integer",
              "unit": "ms",
              "backend_path": "contactors_{instance}.close-time"
            },
            {
              "id": "open-time",
              "display_name": "Open Time",
              "description": "fill in later",
              "value_type": "integer",
              "unit": "ms",
              "backend_path": "contactors_{instance}.open-time"
            }
          ]
        },
        {
          "id": "estops",
          "display_name": "Emergency Stops",
          "instances": [
            { "id": "0", "display_name": "E-Stop 1" },
            { "id": "1", "display_name": "E-Stop 2" },
            { "id": "2", "display_name": "E-Stop 3" }
          ],
          "fields": [
            {
              "id": "enabled",
              "display_name": "Enabled",
              "description": "fill in later",
              "value_type": "enum",
              "enum_values": [
                "disabled",
                "active-low"
              ],
              "backend_path": "estops_{instance}.enabled"
            }
          ]
        }
      ]
    },
    "everest": {
      "title": "CCY Configuration",
      "actions": {
        "read_config_parameters": {
          "group": "everest",
          "action": "read_config_parameters",
          "parameters_mode": "empty"
        },
        "write_config_parameters": {
          "group": "everest",
          "action": "write_config_parameters",
          "parameters_mode": "from_catalog"
        },
        "download_config": {
          "group": "everest",
          "action": "download_config",
          "parameters_mode": "empty"
        },
        "upload_config": {
          "group": "everest",
          "action": "upload_config",
          "parameters_mode": "raw_field",
          "payload_field": "config_yaml"
        }
      },
      "settings_table": {
        "general": [
          {
            "id": "supported_scheduled_mode",
            "display_name": "Scheduled Mode",
            "description": "Whether the EVSE should support scheduled mode",
            "value_type": "boolean",
            "backend_path": "Evse15118D20.supported_scheduled_mode"
          },
          {
            "id": "supported_dynamic_mode",
            "display_name": "Dynamic Mode",
            "description": "Whether the EVSE should support dynamic mode",
            "value_type": "boolean",
            "backend_path": "Evse15118D20.supported_dynamic_mode"
          },
          {
            "id": "disable_authentication",
            "display_name": "Disable Authentication",
            "description": "fill in later",
            "value_type": "boolean",
            "backend_path": "EvseManager.disable_authentication"
          }
        ],
        "profinet": [
          {
            "id": "charger_name",
            "display_name": "Charger Name (EVSEID)",
            "description": "The charger name as used by the Profinet module",
            "value_type": "string",
            "backend_path": "Profinet.charger_name"
          },
          {
            "id": "update_time",
            "display_name": "Update Time",
            "description": "Time period for Profinet periodical data update, in ms",
            "value_type": "integer",
            "unit": "ms",
            "backend_path": "Profinet.update_time"
          },
          {
            "id": "bidirectional_enable",
            "display_name": "Bidirectional Enable",
            "description": "Enable bidirectional charging for power supply",
            "value_type": "boolean",
            "backend_path": "Profinet.bidirectional_enable"
          },
          {
            "id": "profinet_timeout",
            "display_name": "Profinet Timeout",
            "description": "Timeout for sending hlc_stop_transaction to the EV when the Profinet connection interrupts, in s",
            "value_type": "integer",
            "unit": "s",
            "backend_path": "Profinet.profinet_timeout"
          },
          {
            "id": "device",
            "display_name": "Profinet network interface",
            "description": "Profinet Linux network interface (usually eth2)",
            "value_type": "string",
            "backend_path": "Profinet.device"
          },
          {
            "id": "debug_mode",
            "display_name": "Debug Mode",
            "description": "Enables debug mode (PLC simulation) and provides PLC relevant data to EVerest manager",
            "value_type": "boolean",
            "overwrite_value": false,
            "backend_path": "Profinet.debug_mode"
          }
        ]
      },
      "config_loader": {
        "loader": [
          {
            "id": "direct_config",
            "display_name": "Direct config"
          }
        ]
      }
    },
    "ocpp": {
      "title": "OCPP Configuration",
      "actions": {
        "read_settings": {
          "group": "ocpp",
          "action": "read_settings",
          "parameters_mode": "empty"
        },
        "write_settings": {
          "group": "ocpp",
          "action": "write_settings",
          "parameters_mode": "from_catalog"
        }
      },
      "settings_table": {
        "general": [
          {
            "id": "csms_server_address",
            "display_name": "CSMS Endpoint URL",
            "description": "The endpoint URL of the CSMS, without Charging Station Identifier and trailing \"/\"",
            "value_type": "string",
            "backend_path": "InternalCtrlr.NetworkConnectionProfiles.connectionData.ocppCsmsUrl.csmsServerAddress"
          },
          {
            "id": "charge_point_id",
            "display_name": "Charge Point ID",
            "description": "The operational name of the station. It is the ID appended to the CSMS endpoint URL path.",
            "value_type": "string",
            "backend_path": "InternalCtrlr.ChargePointId"
          },
          {
            "id": "identity",
            "display_name": "Security Controller Identity",
            "description": "The Common Name (CN) or Subject Alternative Name (SAN) expected to match the TLS Client Certificate or the HTTP Basic Authentication credentials. If in doubt, keep this identical to \"Charge Point ID\"",
            "value_type": "string",
            "backend_path": "SecurityCtrlr.SecurityCtrlrIdentity"
          }
        ],
        "security": [
          {
            "id": "password",
            "display_name": "Password",
            "description": "The HTTP Basic Authentication password for Security Profiles 1 and 2 (please repeat)",
            "value_type": "secret_string",
            "backend_path": "SecurityCtrlr.BasicAuthPassword"
          },
          {
            "id": "security_profile",
            "display_name": "Security Profile",
            "description": "Security Profile to use (integer from 1 to 3)",
            "value_type": "integer",
            "backend_path": "InternalCtrlr.NetworkConnectionProfiles.connectionData.securityProfile"
          }
        ]
      }
    },
    "pcap": {
      "title": "PCAP Trace Recording",
      "actions": {
        "write": {
          "group": "pcap",
          "action": "write",
          "parameters_mode": "from_catalog"
        },
        "read": {
          "group": "pcap",
          "action": "read",
          "parameters_mode": "empty"
        }
      },
      "capture": {
        "capture_configuration": [
          {
            "id": "interface",
            "display_name": "Interface",
            "description": "",
            "value_type": "string",
            "backend_path": "general.interface"
          }
        ]
      }
    },
    "firmware": {
      "title": "Firmware Update",
      "actions": {
        "read_version": {
          "group": "firmware",
          "action": "read_version",
          "parameters_mode": "empty"
        },
        "upload_image.start": {
          "group": "firmware",
          "action": "upload_image.start",
          "parameters_mode": "from_catalog"
        },
        "upload_image.chunk": {
          "group": "firmware",
          "action": "upload_image.chunk",
          "parameters_mode": "from_catalog"
        },
        "upload_image.finish": {
          "group": "firmware",
          "action": "upload_image.finish",
          "parameters_mode": "empty"
        },
        "update_image": {
          "group": "firmware",
          "action": "update_image",
          "parameters_mode": "empty"
        },
        "reboot": {
          "group": "firmware",
          "action": "reboot",
          "parameters_mode": "empty"
        }
      },
      "updater": {
        "firmware": [
          {
            "id": "controller_firmware",
            "display_name": "Controller Firmware",
            "description": "",
            "value_type": "image",
            "backend_path": "image",
            "chunk_size_bytes": 1048576
          }
        ]
      }
    },
    "system_logs": {
      "title": "System Logs",
      "actions": {
        "read": {
          "group": "logs",
          "action": "read",
          "parameters_mode": "empty"
        },
        "download": {
          "group": "logs",
          "action": "download",
          "parameters_mode": "raw_object"
        },
        "extract": {
          "group": "logs",
          "action": "extract",
          "parameters_mode": "raw_object"
        }
      },
      "files_download": {
        "available_files": [
          {
            "id": "system_log_files",
            "display_name": "Available Log Files"
          }
        ]
      },
      "system_log_extract": {
        "display_name": "System Log Extract",
        "boot_options": [
          { "id": "current", "display_name": "Since last boot" },
          { "id": "two", "display_name": "Last two boots" },
          { "id": "all", "display_name": "Complete available range" }
        ],
        "service_filter": {
          "id": "everest",
          "display_name": "Only everest.service"
        },
        "output_options": [
          { "id": "download", "display_name": "Download file" },
          { "id": "text", "display_name": "Display as text" },
          { "id": "new_tab", "display_name": "Display as text in new tab" }
        ]
      }
    }
  }
}
